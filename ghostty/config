# catppuccin-mocha iceberg-dark rose-pine rose-pine-dawn rose-pine-moon
# theme = Catppuccin Mocha
# theme = Ayu
theme = Dracula

font-family = "Maple Mono NF CN"
font-style = Italic
font-size = 14
font-thicken

background-opacity = 1.00
background-blur = true

macos-titlebar-style = transparent
macos-option-as-alt = true

# 键位绑定
keybind = cmd+shift+h=unbind
keybind = cmd+shift+l=unbind
keybind = cmd+enter=new_tab
keybind = cmd+h=unbind
keybind = cmd+j=unbind
keybind = cmd+k=unbind
keybind = cmd+l=unbind

# cmd+shift+j/k → ctrl+shift+j/k（CSI-u）转发给 herdr 切 workspace
# 106='j' 107='k'，5 = ctrl(4)+shift(1)
keybind = cmd+shift+j=csi:106;5u
keybind = cmd+shift+k=csi:107;5u


# 自定义着色器
custom-shader = /Users/maobai/.config/ghostty/ghostty-shaders/cursor_blaze.glsl
